{
    "name": "mariodevv/nativephp-health-connect",
    "description": "Android Health Connect for NativePHP Mobile: read steps, distance, calories, heart rate, weight, sleep and exercise, with deduplicated aggregates",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [{ "name": "MarioDevv", "email": "perezmario.info@gmail.com" }],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0 || ^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.7|^3.0|^4.0"
    },
    "autoload": { "psr-4": { "MarioDevv\\HealthConnect\\": "src/" } },
    "extra": {
        "laravel": { "providers": ["MarioDevv\\HealthConnect\\HealthConnectServiceProvider"] },
        "nativephp": { "manifest": "nativephp.json" }
    },
    "scripts": { "test": "pest" },
    "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
